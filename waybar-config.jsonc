// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 20, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    "fixed-center": false,
    // Choose the order of the modules
    "modules-left": [
        "niri/workspaces",
        "cffi/niri-taskbar",
        "cpu",
        "memory",
        "temperature",
        "niri/window"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        // "mpd",
        // "custom/media",
        "pulseaudio",
        // "wireplumber",
        "network",
        // "keyboard-state",
        "backlight",
        "power-profiles-daemon",
        "idle_inhibitor",
        "battery",
        "battery#bat2",
        "tray",
        "clock"
    ],
    // Modules configuration
    "niri/workspaces": {
        "format": "{value}",
        "format-icons": {
            // Named workspaces
            // (you need to configure them in niri)
            // "chat": "<b></b>",

            // Icons by state
            "active": "",
            "default": ""
        }
    },
    "cffi/niri-taskbar": {
        "module_path": "/opt/libniri_taskbar.so",
        "notifications": true
    },
    "niri/window": {
        "format": "{}",
        "rewrite": {
            "(.*) — Mozilla Firefox": "🌎 $1",
            "(.*) — Waterfox": "🌎 $1"
        }
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 5,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        // "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 10,
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip": false
    },
    "cpu": {
      "format": "{usage}% {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
      "format-icons": [
        "<span color='#1a8714'>▁</span>", // green
        "<span color='#018fc6'>▂</span>", // blue
        "<span color='#f8f8f2'>▃</span>", // white
        "<span color='#f8f8f2'>▄</span>", // white
        "<span color='#ffffa5'>▅</span>", // yellow
        "<span color='#ffffa5'>▆</span>", // yellow
        "<span color='#ff9977'>▇</span>", // orange
        "<span color='#FF0000'>█</span>"  // red
      ],
      "states": {
        "warning": 60,
        "critical": 90
      }
    },
    "memory": {
        "format": "{}% ",
        "states": {
          "critical": 95
        }
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C"
    },
    "backlight": {
      "on-scroll-up": "brightnessctl --class=backlight set '1%+'",
      "on-scroll-down": "brightnessctl --class=backlight set '1%-'",
      "on-click": "brightnessctl --class=backlight set '50%'",
      "scroll-step": "0.1",
      // "device": "acpi_video1",
      "format": "{percent}% {icon}",
      "format-icons": ["🔅", "🔆"]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ⚡",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "🔇 {icon} {format_source}",
        "format-muted": "🔇 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "🗣️",
            "headset": "🎧",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    }
}

